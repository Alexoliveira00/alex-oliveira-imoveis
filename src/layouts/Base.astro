---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import WhatsIcon from '../components/WhatsIcon.astro';
import { SITE, waLink } from '../config';
const { titulo, descricao = SITE.descricao, imagem = '/uploads/exemplo-1.svg' } = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${SITE.marca}` : `${SITE.marca} – Corretor de imóveis em ${SITE.cidade}`;
const caminho = Astro.url.pathname;
const ativo = (p: string) => (p === '/' ? caminho === '/' : caminho.startsWith(p)) ? 'page' : undefined;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{tituloCompleto}</title>
  <meta name="description" content={descricao} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={new URL(caminho, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={tituloCompleto} />
  <meta property="og:description" content={descricao} />
  <meta property="og:image" content={new URL(imagem, Astro.site)} />
  <meta property="og:locale" content="pt_BR" />
  <meta name="theme-color" content="#1F2A44" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:wght@400;700&family=Public+Sans:wght@400;600&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="topo">
    <div class="container">
      <a class="logo" href="/"><Logo /><span>{SITE.nome}{SITE.creci && <small>CRECI {SITE.creci}</small>}</span></a>
      <nav class="menu" aria-label="Principal">
        <a href="/" aria-current={ativo('/')}>Início</a>
        <a href="/imoveis/" aria-current={ativo('/imoveis')}>Imóveis</a>
        <a href="/sobre/" aria-current={ativo('/sobre')}>Sobre</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer class="rodape">
    <div class="container">
      <div>
        <h3>{SITE.marca}</h3>
        <p>{SITE.descricao}</p>
        {SITE.creci && <p class="creci">Corretor de imóveis – CRECI {SITE.creci}</p>}
      </div>
      <div>
        <h3>Fale comigo</h3>
        <p><a href={waLink('Olá, Alex! Vim pelo site.')}>WhatsApp</a><br />
        {SITE.email && <><a href={`mailto:${SITE.email}`}>{SITE.email}</a><br /></>}
        <a href={`https://instagram.com/${SITE.instagram}`}>@{SITE.instagram}</a></p>
      </div>
      <div>
        <h3>Atendimento</h3>
        <p>{SITE.cidade} e região<br />Segunda a sábado, com hora marcada</p>
      </div>
      <p class="final">© {new Date().getFullYear()} {SITE.marca}. Valores e disponibilidade sujeitos a alteração sem aviso prévio.</p>
    </div>
  </footer>
  <a class="whats-fixo" href={waLink('Olá, Alex! Vim pelo site.')} aria-label="Conversar no WhatsApp"><WhatsIcon /></a>
</body>
</html>
