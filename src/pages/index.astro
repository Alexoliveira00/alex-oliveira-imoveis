---
import Base from '../layouts/Base.astro';
import ImovelCard from '../components/ImovelCard.astro';
import WhatsIcon from '../components/WhatsIcon.astro';
import { getCollection } from 'astro:content';
import { SITE, waLink } from '../config';

const todos = (await getCollection('imoveis')).sort((a, b) => +b.data.data - +a.data.data);
const destaques = todos.filter((i) => i.data.destaque && i.data.disponivel).slice(0, 6);
const capa = destaques[0]?.data.capa ?? '/uploads/exemplo-1.svg';
---
<Base>
  <section class="hero">
    <div class="container hero-grade">
      <div>
        <h1>Casa, apartamento ou terreno em {SITE.cidade}.</h1>
        <p class="hero-texto">Eu faço a busca, marco as visitas e acompanho a documentação até a entrega das chaves.</p>
        <div class="acoes">
          <a class="btn btn-whats" href={waLink('Olá, Alex! Estou procurando um imóvel.')}><WhatsIcon /> Chamar no WhatsApp</a>
          <a class="btn btn-claro" href="/imoveis/">Ver imóveis</a>
        </div>
      </div>
      <figure class="hero-foto">
        <img src={capa} alt="" width="900" height="600" />
      </figure>
    </div>
  </section>

  <section class="container bloco">
    <div class="titulo-linha">
      <h2>Imóveis em destaque</h2>
      <a href="/imoveis/">Ver todos os {todos.filter((i) => i.data.disponivel).length} disponíveis</a>
    </div>
    <div class="grade">
      {destaques.map((imovel) => <ImovelCard imovel={imovel} />)}
    </div>
  </section>

  <section class="container bloco">
    <h2>Como funciona</h2>
    <ol class="passos">
      <li><h3>Conversa</h3><p>Você me conta o que precisa: região, tamanho, orçamento e prazo.</p></li>
      <li><h3>Visitas</h3><p>Seleciono as opções que fazem sentido e vou junto nas visitas.</p></li>
      <li><h3>Negociação e contrato</h3><p>Negocio o valor, confiro a documentação e acompanho financiamento e cartório.</p></li>
    </ol>
  </section>

  <section class="container bloco">
    <div class="chamada">
      <div>
        <h2>Quer vender ou alugar seu imóvel?</h2>
        <p>Faço a avaliação, as fotos e a divulgação no site e no Instagram.</p>
      </div>
      <a class="btn btn-whats" href={waLink('Olá, Alex! Quero anunciar meu imóvel.')}><WhatsIcon /> Anunciar meu imóvel</a>
    </div>
  </section>
</Base>

<style>
  .hero { background: var(--marinho); color: var(--papel); padding-block: 2.5rem 4rem; position: relative; }
  .hero::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 4rem; background: var(--papel); }
  .hero-grade { display: grid; gap: 2.5rem; grid-template-columns: 1.05fr 1fr; align-items: center; position: relative; z-index: 1; }
  .hero h1 { color: var(--papel); }
  .hero-texto { font-size: 1.2rem; color: #D9D4CA; max-width: 40ch; }
  .acoes { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.6rem; }
  .btn-claro { color: var(--papel); box-shadow: inset 0 0 0 1.5px var(--papel); }
  .btn-claro:hover { background: var(--papel); color: var(--marinho); }
  .hero-foto { margin: 0; border-radius: 6px; overflow: hidden; border-bottom: 6px solid var(--dourado); transform: translateY(3rem); }
  .hero-foto img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
  .bloco { margin-top: 5rem; }
  .titulo-linha { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .titulo-linha h2 { margin: 0; }
  .passos { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); counter-reset: passo; }
  .passos li { counter-increment: passo; border-top: 2px solid var(--dourado); padding-top: 1rem; }
  .passos li h3::before { content: counter(passo) '. '; color: var(--dourado-escuro); }
  .chamada { background: var(--branco); border: 1px solid var(--linha); border-left: 6px solid var(--dourado); border-radius: 6px; padding: 2rem; display: flex; gap: 1.5rem; align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .chamada p { margin: 0; }
  @media (max-width: 820px) {
    .hero-grade { grid-template-columns: 1fr; }
    .hero-foto { transform: none; }
    .hero::after { display: none; }
    .hero { padding-bottom: 2.5rem; }
  }
</style>
